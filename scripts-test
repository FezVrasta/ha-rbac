#!/usr/bin/env bash
# Run the test suite.
#
#   python3 -m venv .venv
#   .venv/bin/pip install -r requirements-test.txt
#   ./scripts-test
set -euo pipefail
cd "$(dirname "$0")"
PYTHON="${HA_PYTHON:-.venv/bin/python}"
[ -x "$PYTHON" ] || PYTHON="$(command -v python3)"
exec "$PYTHON" -m pytest "$@"
